{
    "sitemap": {
        "siteUrl": "https://www.dreblowdesigns.com",
        "includeExtensions": [".html"],
        "exclude": [
        "local_dev/",
        "resources/dev/",
        "resources/js/",
        "resources/css/",
        "resources/images/",
        "drafts/",
        "404.html",
        "pages/blog/local_py/"
        ],

        "changefreq": "monthly"
    },

    "imageBuild": {
        "exclude": [
            "local_dev/",
            "pages/blog/local_py/",
            "server/",
            ".git/",
            ".github/",
            ".vscode/"
        ]
    },

    "server": {
        "nginx": {
            "extraRules": "server/nginx/extra-rules.conf"
        }
    }
}