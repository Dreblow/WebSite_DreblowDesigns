{
  "name": "website_dreblowdesigns",
  "version": "1.0.0",
  "description": "Dreblow Designs Portfolio Website and Blog",
  "author": "Derek Dreblow",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dreblow/WebSite_DreblowDesigns.git"
  },
  "bugs": {
    "url": "https://github.com/Dreblow/WebSite_DreblowDesigns/issues"
  },
  "homepage": "https://github.com/Dreblow/WebSite_DreblowDesigns#readme",
  "scripts": {
    "serve": "php -S localhost:8000 -t ..",
    "sync": "browser-sync start --proxy 'localhost:8000' --files '../resources/css/*.css, ../**/*.html, ../**/*.php' --no-ui",
    "dev": "concurrently \"npm run serve\" \"npm run sync\"",
    "build:blog": "python3 ../pages/blog/local_py/main.py"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.3",
    "highlight.js": "^11.12.0"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "typo-js": "^1.3.2"
  }
}